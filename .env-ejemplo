# ==============================================================================
# POLYDATA ENGINE (PDE) - CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# INSTRUCCIONES DE USO:
# 1. Haz una copia de este archivo en la raíz del proyecto y renómbrala a '.env':
#      cp .env-ejemplo .env
# 2. Ajusta las variables según las necesidades de tu entorno (Desarrollo/Producción).
# 3. Asegúrate de añadir '.env' a tu archivo .gitignore para no exponer credenciales.
# ==============================================================================

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL BACKEND (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------

# Host de escucha para el servidor de la API
# Usar '0.0.0.0' para aceptar peticiones externas o de contenedores Docker, o '127.0.0.1' para local.
API_HOST=0.0.0.0

# Puerto de la API FastAPI
API_PORT=8000

# Tamaño máximo de archivo permitido para inspección en el backend (en bytes)
# Valor predeterminado: 104857600 bytes = 100 MB (100 * 1024 * 1024)
MAX_ALLOWED_BYTES=104857600

# Nivel de traza/logs del servidor (opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Lista de orígenes permitidos para CORS (separados por comas sin espacios)
# Permite que el frontend de Streamlit realice peticiones HTTP al backend sin ser bloqueado.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL FRONTEND (Streamlit)
# ------------------------------------------------------------------------------

# URL base completa de la API FastAPI a la que se conectará el frontend
# Importante: Incluir protocolo (http:// o https://) y puerto si corresponde.
PDE_API_URL=http://localhost:8000

# Límite visual e informativo de tamaño máximo de archivo mostrado en la UI (en Megabytes)
# Debe alinearse con el valor de MAX_ALLOWED_BYTES del backend.
MAX_FILE_SIZE_MB=100

# Puerto de escucha predeterminado para el servidor de Streamlit
STREAMLIT_SERVER_PORT=8501

# Dirección de escucha de Streamlit ('0.0.0.0' para red local/Docker, 'localhost' para local estricto)
STREAMLIT_SERVER_ADDRESS=0.0.0.0